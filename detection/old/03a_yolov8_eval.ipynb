{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# EgoRecall — 03a: YOLOv8 Detection Results\n",
    "\n",
    "**Evaluation-only notebook** — training ran on GCP VM via `train_yolo.py`.  \n",
    "Downloads weights from GCS, evaluates on val set, generates comparison plots.\n",
    "\n",
    "**Results expected:**\n",
    "| Model | mAP@0.5 | mAP@0.5:0.95 |\n",
    "|-------|---------|-------------|\n",
    "| YOLOv8s zero-shot (COCO) | 0.0125 | 0.0079 |\n",
    "| YOLOv8s fine-tuned (Ego4D) | TBD | TBD |\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 0 · Imports & Config"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "!pip install ultralytics google-cloud-storage --quiet"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import io\n",
    "import os\n",
    "from pathlib import Path\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.patches as patches\n",
    "from PIL import Image\n",
    "from tqdm.notebook import tqdm\n",
    "from ultralytics import YOLO\n",
    "from google.cloud import storage\n",
    "\n",
    "BUCKET_NAME = \"egorecall-data\"\n",
    "DATA_DIR    = Path(\"/content/egorecall_detection\")\n",
    "RESULTS_DIR = Path(\"/content/results/detection\")\n",
    "RESULTS_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "CONF_THRESHOLD = 0.25\n",
    "\n",
    "import torch\n",
    "DEVICE = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
    "print(f\"Device: {DEVICE}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1 · Auth & Download Weights"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from google.colab import auth\n",
    "auth.authenticate_user()\n",
    "\n",
    "gcs_client = storage.Client()\n",
    "bucket     = gcs_client.bucket(BUCKET_NAME)\n",
    "print(f\"Connected to gs://{BUCKET_NAME}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Download fine-tuned weights and training results from GCS ──────────────\n",
    "os.makedirs(\"/content/models\", exist_ok=True)\n",
    "\n",
    "bucket.blob(\"models/yolov8s_finetuned/best.pt\").download_to_filename(\"/content/models/yolov8s_best.pt\")\n",
    "bucket.blob(\"models/yolov8s_finetuned/results.csv\").download_to_filename(\"/content/models/yolov8s_results.csv\")\n",
    "\n",
    "print(\"Downloaded:\")\n",
    "print(\"  /content/models/yolov8s_best.pt\")\n",
    "print(\"  /content/models/yolov8s_results.csv\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2 · Training Curves"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Plot training curves from results.csv ─────────────────────────────────\n",
    "results_df = pd.read_csv(\"/content/models/yolov8s_results.csv\")\n",
    "results_df.columns = results_df.columns.str.strip()\n",
    "print(f\"Epochs trained: {len(results_df)}\")\n",
    "print(results_df.columns.tolist())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "fig, axes = plt.subplots(2, 3, figsize=(15, 8))\n",
    "\n",
    "metrics = [\n",
    "    (\"train/box_loss\",        \"Train Box Loss\",     axes[0,0]),\n",
    "    (\"train/cls_loss\",        \"Train Cls Loss\",     axes[0,1]),\n",
    "    (\"train/dfl_loss\",        \"Train DFL Loss\",     axes[0,2]),\n",
    "    (\"metrics/mAP50(B)\",      \"Val mAP@0.5\",        axes[1,0]),\n",
    "    (\"metrics/mAP50-95(B)\",   \"Val mAP@0.5:0.95\",   axes[1,1]),\n",
    "    (\"val/box_loss\",          \"Val Box Loss\",        axes[1,2]),\n",
    "]\n",
    "\n",
    "for col, title, ax in metrics:\n",
    "    if col in results_df.columns:\n",
    "        ax.plot(results_df[col], color=\"#4C72B0\", linewidth=2)\n",
    "        ax.set_title(title, fontweight=\"bold\")\n",
    "        ax.set_xlabel(\"Epoch\")\n",
    "        ax.grid(True, alpha=0.3)\n",
    "    else:\n",
    "        ax.set_title(f\"{title} (not found)\", fontweight=\"bold\")\n",
    "\n",
    "plt.suptitle(\"YOLOv8s Fine-Tuning Curves\", fontweight=\"bold\", fontsize=13)\n",
    "plt.tight_layout()\n",
    "plt.savefig(RESULTS_DIR / \"yolov8s_training_curves.png\", dpi=150, bbox_inches=\"tight\")\n",
    "plt.show()\n",
    "\n",
    "# Print best epoch metrics\n",
    "if \"metrics/mAP50(B)\" in results_df.columns:\n",
    "    best_epoch = results_df[\"metrics/mAP50(B)\"].idxmax()\n",
    "    print(f\"\\nBest epoch: {best_epoch + 1}\")\n",
    "    print(f\"  mAP@0.5      : {results_df.loc[best_epoch, 'metrics/mAP50(B)']:.4f}\")\n",
    "    print(f\"  mAP@0.5:0.95 : {results_df.loc[best_epoch, 'metrics/mAP50-95(B)']:.4f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3 · Sync Val Frames for Evaluation\n",
    "\n",
    "Only need val frames — much smaller than full dataset (~5GB)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Download val tar files ─────────────────────────────────────────────────\n",
    "(DATA_DIR / \"val\" / \"images\").mkdir(parents=True, exist_ok=True)\n",
    "(DATA_DIR / \"val\" / \"labels\").mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "print(\"Downloading val tars...\")\n",
    "!gsutil cp gs://egorecall-data/processed/det_val.tar /tmp/det_val.tar\n",
    "!gsutil cp gs://egorecall-data/processed/lbl_val.tar /tmp/lbl_val.tar\n",
    "\n",
    "print(\"Extracting...\")\n",
    "!tar -xf /tmp/det_val.tar -C {DATA_DIR}/val/images/ --strip-components=3\n",
    "!tar -xf /tmp/lbl_val.tar -C {DATA_DIR}/val/labels/ --strip-components=3\n",
    "\n",
    "val_imgs = list((DATA_DIR / \"val\" / \"images\").rglob(\"*.jpg\"))\n",
    "val_lbls = list((DATA_DIR / \"val\" / \"labels\").rglob(\"*.txt\"))\n",
    "print(f\"Val images : {len(val_imgs):,}\")\n",
    "print(f\"Val labels : {len(val_lbls):,}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Flatten val with hard links ────────────────────────────────────────────\n",
    "flat_val = DATA_DIR / \"val\" / \"images_val_flat\"\n",
    "flat_val.mkdir(exist_ok=True)\n",
    "\n",
    "imgs = list((DATA_DIR / \"val\" / \"images\").rglob(\"*.jpg\"))\n",
    "for img_path in tqdm(imgs, desc=\"Flattening val\"):\n",
    "    clip_uid = img_path.parent.name\n",
    "    new_stem = f\"{clip_uid}_{img_path.stem}\"\n",
    "\n",
    "    dst_img = flat_val / f\"{new_stem}.jpg\"\n",
    "    if not dst_img.exists():\n",
    "        os.link(img_path, dst_img)\n",
    "\n",
    "    lbl_path = DATA_DIR / \"val\" / \"labels\" / clip_uid / f\"{img_path.stem}.txt\"\n",
    "    dst_lbl  = flat_val / f\"{new_stem}.txt\"\n",
    "    if lbl_path.exists() and not dst_lbl.exists():\n",
    "        os.link(lbl_path, dst_lbl)\n",
    "\n",
    "flat_imgs = list(flat_val.glob(\"*.jpg\"))\n",
    "flat_lbls = list(flat_val.glob(\"*.txt\"))\n",
    "print(f\"Flat val images : {len(flat_imgs):,}\")\n",
    "print(f\"Flat val labels : {len(flat_lbls):,}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Write dataset.yaml for evaluation ─────────────────────────────────────\n",
    "dataset_yaml = DATA_DIR / \"dataset_eval.yaml\"\n",
    "dataset_yaml.write_text(f\"\"\"path: {DATA_DIR}\n",
    "train: val/images_val_flat\n",
    "val: val/images_val_flat\n",
    "\n",
    "nc: 1\n",
    "names: ['object']\n",
    "\"\"\")\n",
    "print(dataset_yaml.read_text())"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4 · Zero-Shot vs Fine-Tuned Evaluation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Zero-shot results (already computed) ──────────────────────────────────\n",
    "YOLO_ZEROSHOT = {\"mAP@0.5\": 0.0125, \"mAP@0.5:0.95\": 0.0079}\n",
    "print(\"Zero-shot results (pretrained COCO weights):\")\n",
    "print(f\"  mAP@0.5      : {YOLO_ZEROSHOT['mAP@0.5']}\")\n",
    "print(f\"  mAP@0.5:0.95 : {YOLO_ZEROSHOT['mAP@0.5:0.95']}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Fine-tuned evaluation using built-in YOLO val ─────────────────────────\n",
    "yolo_finetuned = YOLO(\"/content/models/yolov8s_best.pt\")\n",
    "val_metrics    = yolo_finetuned.val(data=str(dataset_yaml))\n",
    "\n",
    "YOLO_FINETUNED = {\n",
    "    \"mAP@0.5\"     : val_metrics.box.map50,\n",
    "    \"mAP@0.5:0.95\": val_metrics.box.map,\n",
    "}\n",
    "\n",
    "print(f\"\\nFine-tuned results:\")\n",
    "print(f\"  mAP@0.5      : {YOLO_FINETUNED['mAP@0.5']:.4f}\")\n",
    "print(f\"  mAP@0.5:0.95 : {YOLO_FINETUNED['mAP@0.5:0.95']:.4f}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Comparison table ───────────────────────────────────────────────────────\n",
    "comparison_df = pd.DataFrame([\n",
    "    {\"Model\": \"YOLOv8s zero-shot (COCO)\",  **YOLO_ZEROSHOT},\n",
    "    {\"Model\": \"YOLOv8s fine-tuned (Ego4D)\", **YOLO_FINETUNED},\n",
    "])\n",
    "comparison_df[\"mAP@0.5\"]      = comparison_df[\"mAP@0.5\"].round(4)\n",
    "comparison_df[\"mAP@0.5:0.95\"] = comparison_df[\"mAP@0.5:0.95\"].round(4)\n",
    "comparison_df[\"Improvement\"]  = (\n",
    "    comparison_df[\"mAP@0.5\"] / comparison_df[\"mAP@0.5\"].iloc[0]\n",
    ").round(1).astype(str) + \"x\"\n",
    "\n",
    "print(comparison_df.to_string(index=False))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Bar chart comparison ───────────────────────────────────────────────────\n",
    "fig, axes = plt.subplots(1, 2, figsize=(12, 5))\n",
    "models    = [\"Zero-shot\\n(COCO)\", \"Fine-tuned\\n(Ego4D)\"]\n",
    "colors    = [\"#9ecae1\", \"#2171b5\"]\n",
    "\n",
    "for ax, metric in zip(axes, [\"mAP@0.5\", \"mAP@0.5:0.95\"]):\n",
    "    vals = comparison_df[metric].values\n",
    "    bars = ax.bar(models, vals, color=colors, edgecolor=\"white\", width=0.5)\n",
    "    for bar, val in zip(bars, vals):\n",
    "        ax.text(\n",
    "            bar.get_x() + bar.get_width()/2,\n",
    "            bar.get_height() + 0.001,\n",
    "            f\"{val:.4f}\", ha=\"center\", va=\"bottom\", fontweight=\"bold\"\n",
    "        )\n",
    "    ax.set_title(f\"YOLOv8s — {metric}\", fontweight=\"bold\")\n",
    "    ax.set_ylabel(metric)\n",
    "    ax.set_ylim(0, max(vals) * 1.3 + 0.01)\n",
    "\n",
    "plt.suptitle(\"YOLOv8s: Zero-Shot vs Fine-Tuned (Ego4D VQ)\",\n",
    "             fontweight=\"bold\", fontsize=13)\n",
    "plt.tight_layout()\n",
    "plt.savefig(RESULTS_DIR / \"yolov8s_comparison.png\", dpi=150, bbox_inches=\"tight\")\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Qualitative: visualize predictions on 4 val samples ───────────────────\n",
    "sample_paths = list(flat_val.glob(\"*.jpg\"))[:4]\n",
    "fig, axes    = plt.subplots(2, 4, figsize=(16, 8))\n",
    "\n",
    "for i, img_path in enumerate(sample_paths):\n",
    "    lbl_path = img_path.with_suffix(\".txt\")\n",
    "    img      = np.array(Image.open(img_path))\n",
    "    h, w     = img.shape[:2]\n",
    "\n",
    "    # Ground truth\n",
    "    axes[0, i].imshow(img)\n",
    "    if lbl_path.exists():\n",
    "        for line in lbl_path.read_text().strip().split(\"\\n\"):\n",
    "            if not line.strip(): continue\n",
    "            _, cx, cy, bw, bh = map(float, line.split())\n",
    "            rect = patches.Rectangle(\n",
    "                ((cx-bw/2)*w, (cy-bh/2)*h), bw*w, bh*h,\n",
    "                linewidth=2, edgecolor=\"lime\", facecolor=\"none\"\n",
    "            )\n",
    "            axes[0, i].add_patch(rect)\n",
    "    axes[0, i].set_title(\"Ground Truth\", fontsize=9)\n",
    "    axes[0, i].axis(\"off\")\n",
    "\n",
    "    # Fine-tuned predictions\n",
    "    axes[1, i].imshow(img)\n",
    "    preds = yolo_finetuned.predict(str(img_path), conf=CONF_THRESHOLD, verbose=False)[0]\n",
    "    if preds.boxes is not None:\n",
    "        for box in preds.boxes:\n",
    "            x1, y1, x2, y2 = box.xyxy[0].tolist()\n",
    "            conf = box.conf[0].item()\n",
    "            rect = patches.Rectangle(\n",
    "                (x1, y1), x2-x1, y2-y1,\n",
    "                linewidth=2, edgecolor=\"red\", facecolor=\"none\"\n",
    "            )\n",
    "            axes[1, i].add_patch(rect)\n",
    "            axes[1, i].text(x1, y1-2, f\"{conf:.2f}\",\n",
    "                            color=\"red\", fontsize=7, fontweight=\"bold\")\n",
    "    axes[1, i].set_title(\"YOLOv8s Fine-tuned\", fontsize=9)\n",
    "    axes[1, i].axis(\"off\")\n",
    "\n",
    "plt.suptitle(\"Qualitative Results — Val Samples\", fontweight=\"bold\")\n",
    "plt.tight_layout()\n",
    "plt.savefig(RESULTS_DIR / \"yolov8s_qualitative.png\", dpi=150, bbox_inches=\"tight\")\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Save results to GCS ───────────────────────────────────────────────────\n",
    "comparison_df.to_parquet(\"/tmp/yolov8s_results.parquet\", index=False)\n",
    "bucket.blob(\"processed/yolov8s_results.parquet\").upload_from_filename(\n",
    "    \"/tmp/yolov8s_results.parquet\"\n",
    ")\n",
    "print(f\"Results saved to gs://{BUCKET_NAME}/processed/yolov8s_results.parquet\")"
   ]
  }
 ],
